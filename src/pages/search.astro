---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/urls';
---

<BaseLayout title="검색" description="제목, 태그, 본문에서 궁금한 내용을 찾아보세요." noindex>
  <header class="page-heading">
    <h1>검색</h1>
    <p>제목, 요약, 태그, 본문을 함께 검색합니다.</p>
  </header>
  <div data-search data-index-url={withBase('search-index.json')}>
    <form role="search" action={withBase('search/')} method="get" data-search-form>
      <label for="search-query">검색어</label>
      <div class="search-controls">
        <input id="search-query" name="q" type="search" autocomplete="off" placeholder="궁금한 개념을 입력해 주세요" aria-describedby="search-status" data-search-input />
        <button type="submit">검색</button>
      </div>
    </form>
    <p id="search-status" role="status" aria-live="polite" data-search-status>검색어를 입력해 주세요.</p>
    <ul class="post-list" aria-label="검색 결과" data-search-results></ul>
  </div>
  <noscript><p>검색 기능을 사용하려면 JavaScript를 켜 주세요. <a href={withBase('posts/')}>모든 글</a>이나 <a href={withBase('tags/')}>태그</a>에서도 글을 찾으실 수 있습니다.</p></noscript>
  <script>
    import '../scripts/search';
  </script>
</BaseLayout>
