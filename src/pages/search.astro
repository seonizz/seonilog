---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/urls';
---

<BaseLayout title="검색" description="제목, 태그, 본문에서 궁금한 내용을 찾아보세요." noindex>
  <header class="page-heading">
    <h1>검색</h1>
  </header>
  <div data-search data-index-url={withBase('search-index.json')}>
    <form role="search" action={withBase('search/')} method="get" data-search-form>
      <label class="sr-only" for="search-query">검색어</label>
      <div class="search-controls">
        <input id="search-query" name="q" type="search" autocomplete="off" placeholder="검색어" aria-describedby="search-status" data-search-input />
        <button type="submit">검색</button>
      </div>
    </form>
    <p id="search-status" role="status" aria-live="polite" data-search-status></p>
    <ul class="post-list" aria-label="검색 결과" data-search-results></ul>
  </div>
  <noscript><p>검색에는 JavaScript가 필요합니다. <a href={withBase('posts/')}>모든 글</a></p></noscript>
  <script>
    import '../scripts/search';
  </script>
</BaseLayout>
