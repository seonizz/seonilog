---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, getTags, tagUrl } from '../../lib/posts';
const posts = await getPosts();
const tags = getTags(posts);
---

<BaseLayout title="태그" description="궁금한 주제를 태그로 찾아보세요.">
  <header class="page-heading">
    <h1>태그</h1>
  </header>
  {tags.length ? (
    <ul class="tag-list">
      {tags.map((tag) => <li><a href={tagUrl(tag)}>#{tag} ({posts.filter((post) => post.data.tags.includes(tag)).length})</a></li>)}
    </ul>
  ) : <p>태그가 없습니다.</p>}
</BaseLayout>
