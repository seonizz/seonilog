---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, type Post, formatDate, postUrl, tagUrl } from '../../lib/posts';
import { withBase } from '../../lib/urls';
import { SITE } from '../../config';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, index) => ({
    params: { id: post.id },
    props: { post, newer: posts[index - 1], older: posts[index + 1] },
  }));
}

interface Props { post: Post; newer?: Post; older?: Post }
const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter(({ depth }) => depth === 2 || depth === 3);
const jsonld = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: { '@type': 'Person', name: SITE.author },
  mainEntityOfPage: new URL(postUrl(post), SITE.url).href,
  inLanguage: 'ko-KR',
}).replace(/</g, '\\u003c');
---

<BaseLayout title={post.data.title} description={post.data.description} noindex={post.data.draft} article>
  <script slot="head" type="application/ld+json" set:html={jsonld} />
  <article>
    <header class="page-heading">
      <p><a href={withBase('posts/')}>← 모든 글</a></p>
      {post.data.draft && <p class="draft-label">초안</p>}
      <h1>{post.data.title}</h1>
      <p class="post-meta">
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        {post.data.updatedDate && <> · 수정 <time datetime={post.data.updatedDate.toISOString()}>{formatDate(post.data.updatedDate)}</time></>}
      </p>
      {post.data.tags.length > 0 && (
        <ul class="tag-list" aria-label="글 태그">
          {post.data.tags.map((tag) => <li><a href={tagUrl(tag)}>#{tag}</a></li>)}
        </ul>
      )}
    </header>
    {toc.length > 0 && (
      <nav class="toc" aria-label="이 글의 목차">
        <h2>목차</h2>
        <ul>
          {toc.map(({ slug, text, depth }) => <li class:list={{ 'toc-subheading': depth === 3 }}><a href={`#${slug}`}>{text}</a></li>)}
        </ul>
      </nav>
    )}
    <div class="prose"><Content /></div>
  </article>
  {(older || newer) && (
    <nav class="post-navigation" aria-label="다른 글 읽기">
      {older && <p>이전 글: <a href={postUrl(older)}>{older.data.title}</a></p>}
      {newer && <p>다음 글: <a href={postUrl(newer)}>{newer.data.title}</a></p>}
    </nav>
  )}
</BaseLayout>
