---
import { type Post, postUrl, formatDate } from '../lib/posts';
interface Props { posts: Post[]; emptyMessage?: string }
const { posts, emptyMessage = '글이 없습니다.' } = Astro.props;
---

{posts.length ? (
  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <article class="post-summary">
          <h2><a href={postUrl(post)}>{post.data.title}</a></h2>
          <p class="post-meta">
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
            {post.data.draft && <strong class="draft-label"> · 초안</strong>}
          </p>
        </article>
      </li>
    ))}
  </ul>
) : <p>{emptyMessage}</p>}
